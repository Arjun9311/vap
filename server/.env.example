# ==============================================================================
# Browser Assistant - API Keys Configuration
# ==============================================================================
# MULTI-KEY & RATE-LIMIT OVERCOME SUPPORT:
# You can provide MULTIPLE API keys to bypass rate limits (RPM/TPM/Quota limits).
# The backend automatically rotates between keys (round-robin) and immediately
# switches to the next available key if one hits a rate limit (HTTP 429).
#
# You can format multiple keys in either of two ways:
#   1. Comma-separated:   GROQ_API_KEY=key1,key2,key3
#   2. Numbered variables: GROQ_API_KEY_1=key1
#                          GROQ_API_KEY_2=key2
# ==============================================================================

# Primary Cloud AI: Groq (Get free keys at https://console.groq.com)
# Comma-separated example: GROQ_API_KEY=gsk_key1,gsk_key2,gsk_key3
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (Free keys at https://aistudio.google.com) - RECOMMENDED for VPNs & Vision:
# Comma-separated example: GEMINI_API_KEY=AIzaKey1,AIzaKey2
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter (Free & paid models at https://openrouter.ai):
# Comma-separated example: OPENROUTER_API_KEY=sk-or-v1-key1,sk-or-v1-key2
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local Ollama model (Installed & running locally)
OLLAMA_MODEL=qwen2.5:0.5b
